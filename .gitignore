/dist/
/artifacts/
/datasets/
*.tar.gz
*.zip

# ─── Secrets and local environment ───────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
.hf_token
.huggingface/

# ─── Editors and OS ──────────────────────────────────────────────────────────
.vscode/
